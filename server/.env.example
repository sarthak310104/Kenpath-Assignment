# Server
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# PostgreSQL
# These defaults match docker-compose.yml (user: postgres, password: postgres,
# host port 5433). If you use a local Postgres install instead, change the
# port (usually 5432) and the user/password.
# URL-encode special characters in the password (for example @ becomes %40).
DATABASE_URL=postgres://postgres:postgres@localhost:5433/sweety
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5433/sweety_test

# Auth
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Redis (optional): caches report results, cleared when a reading changes.
# Matches docker-compose.yml (host port 6380). Delete this line or leave it
# empty to run without the cache, the app works the same either way.
REDIS_URL=redis://localhost:6380

# Doctor approval: the endpoints under /api/admin need this in an X-Admin-Key
# header. They are for whoever runs the server. Leave empty to switch them off.
# Change it before deploying anywhere.
ADMIN_API_KEY=change-me-admin-key
