# Server
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# PostgreSQL
# These defaults match docker-compose.yml (user: postgres, password: postgres,
# host port 5433). If you use a local Postgres install instead, change the
# port (usually 5432) and the user/password.
# URL-encode special characters in the password (for example @ becomes %40).
DATABASE_URL=postgres://postgres:postgres@localhost:5433/sweety
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5433/sweety_test

# Auth
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d
